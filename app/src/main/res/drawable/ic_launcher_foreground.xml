        android:pathData="M39,33 L69,33 A9,9 0 0,1 78,42 L78,66 A9,9 0 0,1 69,75 L39,75 A9,9 0 0,1 30,66 L30,42 A9,9 0 0,1 39,33 Z"
        android:strokeColor="#73FFFFFF"
        android:strokeWidth="1.8">
