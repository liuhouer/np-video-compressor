<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主底色：高级深邃科技蓝到电光蔚蓝的平滑对角渐变 -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#0B132B"
                android:centerColor="#1C2541"
                android:endColor="#1E3A8A"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- 左上方柔和环境采光光斑 (径向渐变) -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="28"
                android:centerY="22"
                android:gradientRadius="65"
                android:startColor="#4D38BDF8"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- 背景科技装饰圈：精密同心轨道线 (半透明) -->
    <path
        android:pathData="M54,16 A38,38 0 1,0 54,92 A38,38 0 1,0 54,16"
        android:strokeColor="#1A38BDF8"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,23 A31,31 0 1,0 54,85 A31,31 0 1,0 54,23"
        android:strokeColor="#0DFFFFFF"
        android:strokeWidth="0.8" />

    <!-- 右下角深邃阴影层 (径向渐变) -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="88"
                android:centerY="92"
                android:gradientRadius="55"
                android:startColor="#59030712"
                android:endColor="#00000000"
                android:type="radial" />
        </aapt:attr>
    </path>

</vector>
